# Optional overrides for `docker compose` (copy to .env, which is git-ignored). Every value has the same default in
# docker-compose.yml, so the stack runs without this file. These are LOCAL DEV values only; never reuse them elsewhere.
POSTGRES_PASSWORD=cafepos_dev_pw
# Dev-only JWT signing key (min 32 chars). Production sets Jwt__Key from the host's secret store instead.
JWT_DEV_KEY=DEV-ONLY-compose-signing-key-do-not-use-in-production-0123456789
# Host ports
DB_PORT=5433
API_PORT=5080
WEB_PORT=5173
