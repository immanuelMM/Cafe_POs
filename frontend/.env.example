# Absolute URL of the API including the version segment. It MUST end in /api/v1 (a gateway prefix before it is
# fine, e.g. https://host/pos-api/api/v1); the app fails at startup with a clear error otherwise.
# Never put secrets in VITE_ variables: they are shipped to the browser.
VITE_API_BASE_URL=http://localhost:5080/api/v1
