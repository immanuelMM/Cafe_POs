# URL of the API including the version segment. It MUST end in /api/v1; the app fails at startup with a clear
# error otherwise. Two forms are accepted:
#   absolute:      http://localhost:5080/api/v1  (a gateway prefix is fine: https://host/pos-api/api/v1)
#   root-relative: /api/v1  or  /prefix/api/v1   (resolved against the page's own origin; use when the API
#                  serves the SPA from the same host, so the build does not hard-code a hostname)
# Never put secrets in VITE_ variables: they are shipped to the browser.
VITE_API_BASE_URL=http://localhost:5080/api/v1
